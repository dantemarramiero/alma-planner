{
  "name": "Alma Space",
  "short_name": "Alma Space",
  "description": "L'intranet di Almacis: bacheca, ticket, progetti, strategia, IT ed energia.",
  "lang": "it",
  "id": "/app",
  "start_url": "/app#/benvenuto",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F6F3",
  "theme_color": "#FFFFFF",
  "icons": [
    { "src": "/brand/almacis/app-icon-192.png?v=3", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/almacis/app-icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/almacis/app-icon-maskable-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "foto",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
